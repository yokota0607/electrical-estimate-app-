# Neon PostgreSQL 接続URL（Neonダッシュボード → Connection Details → Connection string）
DATABASE_URL=

# Vercel Blob（Vercelダッシュボード → Storage → Blob → .env.localタブからコピー）
BLOB_READ_WRITE_TOKEN=

# Anthropic Claude API キー
ANTHROPIC_API_KEY=

# セッション署名キー（任意の長いランダム文字列）
AUTH_SECRET=change-me-to-a-long-random-secret

# 閲覧専用の経営サマリーAPI（GET /api/public/business-summary?token=...）用トークン
# AUTH_SECRET やログインパスワードとは別物のランダム値を設定する
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PUBLIC_REPORT_TOKEN=
